<settings
  xmlns="http://maven.apache.org/SETTINGS/1.1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd">

  <servers>
    <server>
      <id>gitlab-maven</id>
      <configuration>
        <httpHeaders>
          <property>
            <name>Job-Token</name>
            <value>${env.CI_JOB_TOKEN}</value>
          </property>
        </httpHeaders>
      </configuration>
    </server>
  </servers>

  <!-- Optional but recommended: ensure Maven can RESOLVE from GitLab even if pom has no repositories -->
  <profiles>
    <profile>
      <id>gitlab</id>
      <repositories>
        <repository>
          <id>gitlab-maven</id>
          <url>https://gitlab.clearskysolutions.co.th/api/v4/packages/maven</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>

      <pluginRepositories>
        <pluginRepository>
          <id>gitlab-maven</id>
          <url>https://gitlab.clearskysolutions.co.th/api/v4/packages/maven</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>gitlab</activeProfile>
  </activeProfiles>

  <!-- Optional: if you want to force ALL artifact downloads through GitLab (usually not needed) -->
  <!--
  <mirrors>
    <mirror>
      <id>gitlab-maven-mirror</id>
      <mirrorOf>*,!central</mirrorOf>
      <url>https://gitlab.clearskysolutions.co.th/api/v4/packages/maven</url>
    </mirror>
  </mirrors>
  -->
</settings>
